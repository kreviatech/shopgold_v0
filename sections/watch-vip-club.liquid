{%- style -%}
  .watch-vip-{{ section.id }} {
    background-color: var(--watch-dark-surface);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(197, 160, 89, 0.15);
  }

  .watch-vip__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .watch-vip__card {
    position: relative;
    background: radial-gradient(circle at 50% 0%, rgba(197, 160, 89, 0.12) 0%, rgba(16, 16, 22, 0.98) 60%), #101016;
    border: 1px solid var(--watch-border-gold);
    border-radius: 6px;
    padding: 5rem 3rem;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(197, 160, 89, 0.12);
  }

  @media screen and (min-width: 750px) {
    .watch-vip__card {
      padding: 7rem 6rem;
    }
  }

  .watch-vip__title {
    font-size: clamp(2.8rem, 4vw, 4.6rem);
    color: #FFFFFF;
    margin: 0 0 1.6rem 0;
  }

  .watch-vip__desc {
    font-size: 1.55rem;
    line-height: 1.7;
    color: var(--watch-text-secondary);
    max-width: 620px;
    margin: 0 auto 3.5rem auto;
  }

  .watch-vip__perks-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem 2.8rem;
    margin-bottom: 4rem;
  }

  .watch-vip__perk {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.25rem;
    color: var(--watch-text-primary);
    font-weight: 500;
  }

  .watch-vip__perk-dot {
    color: var(--watch-gold-primary);
    font-size: 1.2em;
  }

  .watch-vip__form-wrap {
    max-width: 520px;
    margin: 0 auto;
  }

  .watch-vip__form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  @media screen and (min-width: 600px) {
    .watch-vip__form {
      flex-direction: row;
      gap: 0;
    }
  }

  .watch-vip__input {
    flex: 1;
    background: #0B0B0E !important;
    border: 1px solid var(--watch-border-gold) !important;
    color: var(--watch-text-primary) !important;
    padding: 1.6rem 2rem !important;
    font-size: 1.4rem !important;
    font-family: var(--watch-font-body) !important;
    border-radius: 2px 0 0 2px !important;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  @media screen and (max-width: 599px) {
    .watch-vip__input {
      border-radius: 2px !important;
    }
  }

  .watch-vip__input:focus {
    border-color: var(--watch-gold-light) !important;
    box-shadow: 0 0 15px var(--watch-gold-glow) !important;
  }

  .watch-vip__btn {
    border-radius: 0 2px 2px 0 !important;
    padding: 1.6rem 3rem !important;
    white-space: nowrap;
  }

  @media screen and (max-width: 599px) {
    .watch-vip__btn {
      border-radius: 2px !important;
    }
  }

  .watch-vip__success {
    color: var(--watch-gold-light);
    font-size: 1.4rem;
    margin-top: 1.5rem;
    font-family: var(--watch-font-heading);
    letter-spacing: 0.1em;
  }

  .watch-vip__disclaimer {
    font-size: 1.15rem;
    color: var(--watch-text-muted);
    margin-top: 2rem;
    letter-spacing: 0.05em;
  }
{%- endstyle -%}

<section class="watch-vip-{{ section.id }} color-scheme-2" aria-label="VIP Collectors Club">
  <div class="watch-vip__container">
    <div class="watch-vip__card">
      {%- if section.settings.eyebrow != blank -%}
        <div class="watch-eyebrow">
          <span>{{ section.settings.eyebrow | escape }}</span>
        </div>
      {%- endif -%}

      <h2 class="watch-vip__title">
        {{ section.settings.heading | escape }}
      </h2>

      {%- if section.settings.description != blank -%}
        <p class="watch-vip__desc">
          {{ section.settings.description | escape }}
        </p>
      {%- endif -%}

      <div class="watch-vip__perks-list">
        <div class="watch-vip__perk">
          <span class="watch-vip__perk-dot">&#9670;</span>
          <span>Limited Production Allocations</span>
        </div>
        <div class="watch-vip__perk">
          <span class="watch-vip__perk-dot">&#9670;</span>
          <span>Private Salon Viewings</span>
        </div>
        <div class="watch-vip__perk">
          <span class="watch-vip__perk-dot">&#9670;</span>
          <span>Complimentary 3-Year Overhaul</span>
        </div>
      </div>

      <div class="watch-vip__form-wrap">
        {% form 'customer', class: 'watch-vip__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, vip-collector">
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            class="watch-vip__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="Enter your private email address"
            required
          >
          <button
            type="submit"
            class="button button--primary watch-vip__btn"
            name="commit"
            id="Subscribe--{{ section.id }}"
          >
            REQUEST ACCESS
          </button>

          {%- if form.posted_successfully? -%}
            <p class="watch-vip__success" tabindex="-1" autofocus>
              &#10003; Welcome to the Horology Salon. Your invitation has been dispatched.
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <small class="form__message error" id="Newsletter-error--{{ section.id }}">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        {% endform %}

        <p class="watch-vip__disclaimer">
          Discretion guaranteed. You may revoke membership at any time.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Watch VIP Club",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "PRIVATE CONCIERGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE HOROLOGY SALON"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Receive private allocations on numbered timepiece releases, bespoke invitations to masterclass exhibitions, and our quarterly horological journal."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Watch VIP Club"
    }
  ]
}
{% endschema %}
