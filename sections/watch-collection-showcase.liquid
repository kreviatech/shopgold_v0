{%- style -%}
  .watch-collections-{{ section.id }} {
    background-color: var(--watch-dark-base);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  .watch-collections__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .watch-collections__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4.5rem auto;
  }

  .watch-collections__title {
    font-size: clamp(2.6rem, 3.8vw, 4.2rem);
    color: var(--watch-text-primary);
    margin: 0 0 1.4rem 0;
  }

  .watch-collections__desc {
    font-size: 1.5rem;
    color: var(--watch-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .watch-collections__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 750px) {
    .watch-collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .watch-collections__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    }
  }

  .watch-cat-card {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background: var(--watch-dark-card);
    border: 1px solid var(--watch-border-card);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    group: hover;
  }

  .watch-cat-card:hover {
    border-color: var(--watch-border-gold);
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.8), 0 0 25px rgba(197, 160, 89, 0.12);
  }

  .watch-cat-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: radial-gradient(circle at center, #1E1E26 0%, #101015 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .watch-cat-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .watch-cat-card:hover .watch-cat-card__image {
    transform: scale(1.08);
  }

  .watch-cat-card__svg-fallback {
    width: 70%;
    height: 70%;
    transition: transform 0.5s ease;
  }

  .watch-cat-card:hover .watch-cat-card__svg-fallback {
    transform: scale(1.06);
  }

  .watch-cat-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 11, 14, 0.95) 0%, rgba(11, 11, 14, 0.2) 50%, transparent 100%);
    z-index: 1;
  }

  .watch-cat-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2.2rem 2rem;
    z-index: 2;
  }

  .watch-cat-card__tag {
    font-size: 1.05rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--watch-gold-light);
    font-weight: 600;
    margin-bottom: 0.6rem;
    display: block;
  }

  .watch-cat-card__name {
    font-family: var(--watch-font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1rem 0;
  }

  .watch-cat-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--watch-text-gold);
    transition: gap 0.25s ease, color 0.25s ease;
  }

  .watch-cat-card:hover .watch-cat-card__cta {
    gap: 1rem;
    color: var(--watch-gold-light);
  }
{%- endstyle -%}

<section class="watch-collections-{{ section.id }} color-scheme-1" aria-label="Curated Watch Collections">
  <div class="watch-collections__container">
    <div class="watch-collections__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="watch-eyebrow">
          <span>{{ section.settings.eyebrow | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="watch-collections__title">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="watch-collections__desc">
          {{ section.settings.description | escape }}
        </p>
      {%- endif -%}
    </div>

    <div class="watch-collections__grid">
      {%- for block in section.blocks -%}
        {%- assign current_collection = block.settings.collection -%}
        {%- assign collection_url = current_collection.url | default: block.settings.custom_url | default: routes.all_products_collection_url -%}

        <a href="{{ collection_url }}" class="watch-cat-card" {{ block.shopify_attributes }}>
          <div class="watch-cat-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  class: 'watch-cat-card__image',
                  alt: block.settings.title,
                  widths: '350, 600, 800'
              }}
            {%- elsif current_collection.featured_image != blank -%}
              {{
                current_collection.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  class: 'watch-cat-card__image',
                  alt: block.settings.title,
                  widths: '350, 600, 800'
              }}
            {%- else -%}
              <!-- Stylized Horology Category Icon Fallback -->
              <svg class="watch-cat-card__svg-fallback" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="100" r="80" stroke="#C5A059" stroke-width="2" stroke-opacity="0.4"/>
                <circle cx="100" cy="100" r="70" stroke="#C5A059" stroke-width="1" stroke-dasharray="3 5"/>
                <circle cx="100" cy="100" r="50" fill="#141419" stroke="#C5A059" stroke-width="1.5"/>
                <line x1="100" y1="40" x2="100" y2="52" stroke="#E5C37A" stroke-width="3"/>
                <line x1="160" y1="100" x2="148" y2="100" stroke="#E5C37A" stroke-width="3"/>
                <line x1="100" y1="160" x2="100" y2="148" stroke="#E5C37A" stroke-width="3"/>
                <line x1="40" y1="100" x2="52" y2="100" stroke="#E5C37A" stroke-width="3"/>
                <!-- Hands -->
                <line x1="100" y1="100" x2="100" y2="65" stroke="#E5C37A" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="100" y1="100" x2="128" y2="115" stroke="#C5A059" stroke-width="2" stroke-linecap="round"/>
                <circle cx="100" cy="100" r="4" fill="#E5C37A"/>
              </svg>
            {%- endif -%}

            <div class="watch-cat-card__overlay"></div>
          </div>

          <div class="watch-cat-card__content">
            <span class="watch-cat-card__tag">
              {%- if block.settings.tag != blank -%}
                {{ block.settings.tag | escape }}
              {%- elsif current_collection != blank -%}
                {{ current_collection.all_products_count }} Timepieces
              {%- else -%}
                Masterpiece
              {%- endif -%}
            </span>

            <h3 class="watch-cat-card__name">
              {{ block.settings.title | default: current_collection.title | default: 'Collection' | escape }}
            </h3>

            <span class="watch-cat-card__cta">
              Explore Series <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Watch Category Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CURATED HOROLOGY SERIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ICONIC TIMEPIECE SERIES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Engineered for uncompromising accuracy and luxury distinction across every discipline."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Series Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "default": "Racing Chronographs"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge / Sub-label",
          "default": "High-Velocity Precision"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom URL (if no collection selected)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Watch Category Grid",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Racing Chronographs",
            "tag": "Tachymeter Scale"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Automatic Divers",
            "tag": "300M Waterproof"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Tourbillon & Skeleton",
            "tag": "Haute Complication"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Classic Dress",
            "tag": "Guilloché Dials"
          }
        }
      ]
    }
  ]
}
{% endschema %}
